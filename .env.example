# FleetVision AI — Unified Environment Configuration
PORT=8000
HOST=0.0.0.0

# Database Settings
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=fleetvision_ai

# Secret key used for signing session cookies
SESSION_SECRET=fleetvision-super-secure-token-signing-secret-2026

# Authentik OIDC Configuration
# When Authentik is running locally via Docker Compose (default port 9000):
AUTHENTIK_HOST=http://localhost:9000
AUTHENTIK_APP_SLUG=fleetvision-ai
AUTHENTIK_CLIENT_ID=fleetvision-client-id-from-authentik
AUTHENTIK_CLIENT_SECRET=fleetvision-client-secret-from-authentik
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/auth/callback
