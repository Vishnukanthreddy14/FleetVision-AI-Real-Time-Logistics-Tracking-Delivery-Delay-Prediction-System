{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🐳 Docker: Start Core Stack (App + MongoDB)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🍃 Docker: Start MongoDB Only (Port 27017)",
      "type": "shell",
      "command": "docker compose up -d mongodb",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🛑 Docker: Stop All Containers",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📜 Docker: View App Logs",
      "type": "shell",
      "command": "docker compose logs -f app",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔄 Docker: Rebuild & Restart",
      "type": "shell",
      "command": "docker compose down && docker compose up -d --build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🛡️ Docker: Start Full Stack with Authentik IdP",
      "type": "shell",
      "command": "docker compose --profile auth up -d",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "💻 Python: Run Server Locally",
      "type": "shell",
      "command": "python3 run.py",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧠 Python: Retrain Random Forest Models",
      "type": "shell",
      "command": "python3 ml/train_rf.py",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
